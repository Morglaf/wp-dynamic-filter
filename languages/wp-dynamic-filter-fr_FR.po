msgid "WP Dynamic Filter requires WordPress 6.7 or newer."
msgstr "WP Dynamic Filter nécessite WordPress 6.7 ou plus récent."

msgid "Dynamic Filter Query (legacy)"
msgstr "Dynamic Filter Query (ancien)"

msgid "All"
msgstr "Tous"

msgid "Filter by term"
msgstr "Filtrer par terme"

msgid "Invalid security token."
msgstr "Jeton de sécurité invalide."

msgid "Invalid filter request."
msgstr "Requête de filtre invalide."

msgid "Taxonomy not found."
msgstr "Taxonomie introuvable."

msgid "Taxonomy is not public."
msgstr "La taxonomie n’est pas publique."

msgid "Term not found."
msgstr "Terme introuvable."

msgid "Filter block instance not found."
msgstr "Instance du bloc filtre introuvable."

msgid "No Query Loop found inside the filter block."
msgstr "Aucune boucle de requête trouvée dans le bloc filtre."

msgid "Source content not found."
msgstr "Contenu source introuvable."

msgid "You cannot view this content."
msgstr "Vous ne pouvez pas voir ce contenu."

msgid "Filter"
msgstr "Filtre"

msgid "Place your Query Loop inside (or transform an existing loop). You can remove the default loop and drag yours in."
msgstr "Placez votre Query Loop à l’intérieur (ou transformez une boucle existante). Vous pouvez supprimer la boucle par défaut et y glisser la vôtre."

msgid "Taxonomy"
msgstr "Taxonomie"

msgid "Display"
msgstr "Affichage"

msgid "Buttons"
msgstr "Boutons"

msgid "Dropdown"
msgstr "Menu déroulant"

msgid "Multiple selection"
msgstr "Sélection multiple"

msgid "Allow combining several terms (OR logic)."
msgstr "Permet de cumuler plusieurs termes (logique OU)."

msgid "Show “All” button"
msgstr "Afficher le bouton « Tous »"

msgid "“All” button label"
msgstr "Libellé du bouton « Tous »"

msgid "Post counts"
msgstr "Compteur d’articles"

msgid "Empty results message"
msgstr "Message si vide"

msgid "Categories"
msgstr "Catégories"

msgid "Tags"
msgstr "Étiquettes"

msgid "Add or move your Query Loop here."
msgstr "Ajoutez ou déplacez ici votre boucle de requête (Query Loop)."
