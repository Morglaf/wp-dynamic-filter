msgid "WP Dynamic Filter requires WordPress 6.7 or newer."
msgstr "WP Dynamic Filter erfordert WordPress 6.7 oder neuer."

msgid "Dynamic Filter Query (legacy)"
msgstr "Dynamic Filter Query (veraltet)"

msgid "All"
msgstr "Alle"

msgid "Filter by term"
msgstr "Nach Begriff filtern"

msgid "Invalid security token."
msgstr "Ungültiges Sicherheitstoken."

msgid "Invalid filter request."
msgstr "Ungültige Filteranfrage."

msgid "Taxonomy not found."
msgstr "Taxonomie nicht gefunden."

msgid "Taxonomy is not public."
msgstr "Die Taxonomie ist nicht öffentlich."

msgid "Term not found."
msgstr "Begriff nicht gefunden."

msgid "Filter block instance not found."
msgstr "Filter-Block-Instanz nicht gefunden."

msgid "No Query Loop found inside the filter block."
msgstr "Keine Abfrageschleife im Filter-Block gefunden."

msgid "Source content not found."
msgstr "Quellinhalte nicht gefunden."

msgid "You cannot view this content."
msgstr "Sie können diesen Inhalt nicht ansehen."

msgid "Filter"
msgstr "Filter"

msgid "Place your Query Loop inside (or transform an existing loop). You can remove the default loop and drag yours in."
msgstr "Platzieren Sie Ihre Query Loop darin (oder wandeln Sie eine vorhandene Schleife um). Sie können die Standardschleife entfernen und Ihre eigene hineinziehen."

msgid "Taxonomy"
msgstr "Taxonomie"

msgid "Display"
msgstr "Anzeige"

msgid "Buttons"
msgstr "Schaltflächen"

msgid "Dropdown"
msgstr "Dropdown"

msgid "Multiple selection"
msgstr "Mehrfachauswahl"

msgid "Allow combining several terms (OR logic)."
msgstr "Ermöglicht das Kombinieren mehrerer Begriffe (ODER-Logik)."

msgid "Show “All” button"
msgstr "Schaltfläche „Alle“ anzeigen"

msgid "“All” button label"
msgstr "Beschriftung der Schaltfläche „Alle“"

msgid "Post counts"
msgstr "Beitragsanzahl"

msgid "Empty results message"
msgstr "Nachricht bei leeren Ergebnissen"

msgid "Categories"
msgstr "Kategorien"

msgid "Tags"
msgstr "Schlagwörter"

msgid "Add or move your Query Loop here."
msgstr "Fügen Sie hier Ihre Abfrageschleife (Query Loop) hinzu oder verschieben Sie sie."
